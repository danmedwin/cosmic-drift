{
  "appId": "com.medwin.cosmicdrift",
  "appName": "Cosmic Drift",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "scrollEnabled": false,
    "allowsLinkPreview": false,
    "backgroundColor": "#0b0c1a",
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": false,
      "backgroundColor": "#0b0c1a",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK"
    }
  }
}
